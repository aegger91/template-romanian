---
/** Line pictograms for services and sacraments (64x64 grid). */
interface Props {
  name: string;
  size?: number;
}
const { name, size = 72 } = Astro.props;

const budCross = (x: number, y: number, h = 10, w = 9) => {
  const top = y - h / 2;
  const bottom = y + h / 2;
  const arm = y - h / 2 + h * 0.4;
  return `<path d="M${x} ${top}V${bottom}M${x - w / 2} ${arm}h${w}"/><g fill="currentColor" stroke="none"><circle cx="${x}" cy="${top}" r="1.5"/><circle cx="${x}" cy="${bottom}" r="1.5"/><circle cx="${x - w / 2}" cy="${arm}" r="1.5"/><circle cx="${x + w / 2}" cy="${arm}" r="1.5"/></g>`;
};

const flame = (x: number, y: number, s = 1) =>
  `<path d="M${x} ${y}c${1.6 * s} ${2.1 * s} ${2.4 * s} ${3.4 * s} ${2.4 * s} ${4.6 * s}a${2.4 * s} ${2.4 * s} 0 0 1-${4.8 * s} 0c0-${1.2 * s} ${0.8 * s}-${2.5 * s} ${2.4 * s}-${4.6 * s}z" fill="currentColor" fill-opacity="0.22"/>`;

const crown = (cx: number) =>
  `<path d="M${cx - 10} 42 ${cx - 11.5} 29l6 5.2L${cx} 25.5l5.5 8.7 6-5.2L${cx + 10} 42z" fill="currentColor" fill-opacity="0.1"/><rect x="${cx - 10.5}" y="42" width="21" height="7" rx="1.2"/><g fill="currentColor" stroke="none"><circle cx="${cx - 5.5}" cy="45.5" r="1.2"/><circle cx="${cx}" cy="45.5" r="1.2"/><circle cx="${cx + 5.5}" cy="45.5" r="1.2"/></g>${budCross(cx, 19.5, 9, 7)}`;

const shapes: Record<string, string> = {
  font: `${budCross(32, 12, 11, 9)}<path d="M12 27h40"/><path d="M14 27c0 10.5 8 17 18 17s18-6.5 18-17" fill="currentColor" fill-opacity="0.1"/><path d="M20.5 33c3.8 2 7.7 2 11.5 0s7.7-2 11.5 0" opacity="0.6"/><path d="M27 44v7h10v-7"/><path d="M22 51.5h20M18 57h28"/>`,
  crowns: `${crown(20)}${crown(44)}<path d="M8 56c9-3.2 39-3.2 48 0"/>`,
  stole: `<path d="M22 8c3 4 6.5 6 10 6s7-2 10-6"/><path d="M22 8l-1.5 26M42 8l1.5 26"/><path d="M27.5 12.6V34M36.5 12.6V34"/><rect x="17" y="32" width="30" height="24" rx="2" fill="currentColor" fill-opacity="0.1"/><rect x="17" y="32" width="30" height="24" rx="2"/>${budCross(32, 44, 12, 10)}`,
  unction: `<path d="M10 40h44c-1.5 9-9.5 15-22 15S11.5 49 10 40z" fill="currentColor" fill-opacity="0.1"/><path d="M24 55l-2 4h20l-2-4"/>${[17, 22, 27, 32, 37, 42, 47]
    .map((x, i) => {
      const top = [28, 26, 24, 22, 24, 26, 28][i];
      return `<path d="M${x} 40V${top}"/>${flame(x, top - 7.5, 0.8)}`;
    })
    .join('')}`,
  candle: `${flame(32, 7, 1.5)}<rect x="26.5" y="21" width="11" height="29" rx="1.6" fill="currentColor" fill-opacity="0.1"/><rect x="26.5" y="21" width="11" height="29" rx="1.6"/><path d="M32 21v-3"/><path d="M18 50h28l-3 6H21z"/><path d="M14 59h36"/>`,
  koliva: `<ellipse cx="32" cy="51" rx="24" ry="5"/><path d="M11.5 50c1.5-9 10-14 20.5-14s19 5 20.5 14" fill="currentColor" fill-opacity="0.1"/>${budCross(32, 43.5, 8, 8)}<rect x="30" y="18" width="4" height="15" rx="0.8"/>${flame(32, 9, 0.9)}`,
  blessing: `<path d="M12 34h40c0 11-9 19-20 19s-20-8-20-19z" fill="currentColor" fill-opacity="0.1"/><path d="M24 53v4h16v-4"/>${budCross(32, 43, 9, 8)}<path d="M38.5 34C41.5 24 46.5 16 54 8.5"/><path d="M44.6 22.2c-4-.8-6.6-3.8-6.8-7.2 4 .6 6.6 3.6 6.8 7.2z" fill="currentColor" fill-opacity="0.22"/><path d="M48.6 16.4c3.8.2 7-1.6 8.4-4.8-4-.2-7.2 1.6-8.4 4.8z" fill="currentColor" fill-opacity="0.22"/><path d="M41.4 28.4c-4.6.2-7.4-2.2-8.6-5.4 4.6-.2 7.4 2.2 8.6 5.4z" fill="currentColor" fill-opacity="0.22"/>`,
  names: `<path d="M16 6h26l8 8v44H16z" fill="currentColor" fill-opacity="0.08"/><path d="M16 6h26l8 8v44H16z"/><path d="M42 6v8h8"/>${budCross(33, 18, 10, 9)}<path d="M22 31h22M22 37h22M22 43h16M22 49h20" opacity="0.75"/>`,
};
const body = shapes[name] ?? '';
---
<svg
  class="pictogram"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
