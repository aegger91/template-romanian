---
/** Placeholder portrait in an arched niche. Shows a photo when one is supplied. */
interface Props {
  name: string;
  photo?: string;
  label: string;
  tone?: number;
}
const { name, photo, label, tone = 0 } = Astro.props;
const tones = [
  ['#0f2f4a', '#255f91'],
  ['#451217', '#843038'],
  ['#34402f', '#5d6b52'],
  ['#4b3818', '#8a6b2e'],
];
const [c1, c2] = tones[tone % tones.length];
const uid = `pt${Math.random().toString(36).slice(2, 8)}`;
---
{photo ? (
  <img class="portrait" src={photo} alt={name} width="600" height="720" loading="lazy" />
) : (
  <svg class="portrait" viewBox="0 0 300 360" role="img" aria-label={`${label}: ${name}`}>
    <defs>
      <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0.4" y2="1">
        <stop offset="0" stop-color={c2} />
        <stop offset="1" stop-color={c1} />
      </linearGradient>
      <radialGradient id={`${uid}-glow`} cx="0.5" cy="0.28" r="0.6">
        <stop offset="0" stop-color="#ffe7b0" stop-opacity="0.35" />
        <stop offset="1" stop-color="#ffe7b0" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="300" height="360" fill={`url(#${uid}-bg)`} />
    <rect width="300" height="360" fill={`url(#${uid}-glow)`} />
    <path d="M58 360V160a92 92 0 0 1 184 0v200" fill="rgba(255,252,247,0.08)" stroke="#e0c07a" stroke-opacity="0.75" stroke-width="2" />
    <path d="M74 360V162a76 76 0 0 1 152 0v198" fill="none" stroke="#e0c07a" stroke-opacity="0.32" stroke-width="1.2" />
    <path d="M150 0v52" stroke="#e0c07a" stroke-opacity="0.8" stroke-width="1.4" />
    <path d="M137 52h26l-5 15h-16z" fill="#e0c07a" fill-opacity="0.85" />
    <circle cx="150" cy="73" r="3.2" fill="#ffd88a" />
    <circle cx="150" cy="196" r="34" fill="rgba(255,252,247,0.22)" />
    <path d="M80 360c0-64 31-112 70-112s70 48 70 112z" fill="rgba(255,252,247,0.22)" />
    <rect x="104" y="318" width="92" height="22" rx="11" fill="rgba(15,20,18,0.45)" />
    <text x="150" y="333" text-anchor="middle" font-family="Source Sans 3, sans-serif" font-size="11" letter-spacing="1.2" fill="#fffcf7">{label.toUpperCase()}</text>
  </svg>
)}
