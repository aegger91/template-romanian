---
/** Flat placeholder portrait. Shows a photo when one is supplied. */
interface Props {
  name: string;
  photo?: string;
  label: string;
  tone?: number;
}
const { name, photo, label, tone = 0 } = Astro.props;
const tones = [
  { bg: '#e2eaf2', fg: '#1c4b77' },
  { bg: '#efe4dc', fg: '#7c2430' },
  { bg: '#ebe3d3', fg: '#8a6b3f' },
  { bg: '#e6ebe8', fg: '#3d5a4c' },
];
const { bg, fg } = tones[tone % tones.length];
---
{photo ? (
  <img class="portrait" src={photo} alt={name} width="600" height="720" loading="lazy" style="object-fit:cover" />
) : (
  <svg class="portrait" viewBox="0 0 300 300" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${label}: ${name}`}>
    <rect width="300" height="300" fill={bg} />
    <circle cx="150" cy="122" r="40" fill={fg} fill-opacity="0.16" />
    <path d="M70 300c0-62 36-104 80-104s80 42 80 104z" fill={fg} fill-opacity="0.16" />
    <path d="M150 34v26M144.5 40.5h11M139 48h22M142.2 57.5 157.8 62" stroke={fg} stroke-opacity="0.35" stroke-width="2" stroke-linecap="round" fill="none" />
  </svg>
)}
