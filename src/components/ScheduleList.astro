---
import type { Locale } from '../config/site';
import { siteConfig } from '../config/site';
import type { ScheduleItem } from '../config/schedule';
import { nextDays } from '../config/schedule';
import { t } from '../i18n/ui';
import { displayDates, formatShortDate, buildIcs, googleCalendarUrl } from '../utils/dates';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  items: ScheduleItem[];
  layout?: 'week' | 'list' | 'calendar' | 'compact';
  /** compact layout: label rows by weekday instead of date */
  weekly?: boolean;
  labels?: { today: string; empty: string };
}
const { locale, items, layout = 'list', weekly = false, labels } = Astro.props;
const dict = t(locale);
const parish = siteConfig.name[locale];
const tag = locale === 'ro' ? 'ro-RO' : 'en-GB';
const uid = `sch-${Math.random().toString(36).slice(2, 8)}`;

const toDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(y, m - 1, d, 12);
};

const payload = items.map((item) => {
  const dates = displayDates(item.date, locale);
  const dt = toDate(item.date);
  return {
    id: item.id,
    date: item.date,
    title: item.title[locale],
    description: item.description[locale],
    dateLabel: dates.primary,
    shortDate: formatShortDate(item.date, locale),
    dayNum: String(dt.getDate()),
    dayName: dt.toLocaleDateString(tag, { weekday: 'short' }),
    weekdayLong: dt.toLocaleDateString(tag, { weekday: 'long' }),
    monthShort: dt.toLocaleDateString(tag, { month: 'short' }),
    oldStyleLabel: dates.secondary,
    time: `${item.startTime}-${item.endTime}`,
    location: item.location?.[locale] ?? parish,
    ics: buildIcs(item, locale, parish),
    google: googleCalendarUrl(item, locale, parish),
    map: siteConfig.mapUrl,
  };
});

const today = nextDays(1)[0];
const calendarDays =
  layout === 'calendar'
    ? nextDays(7).map((iso) => {
        const dt = toDate(iso);
        return {
          iso,
          isToday: iso === today,
          dow: dt.toLocaleDateString(tag, { weekday: 'short' }),
          dowLong: dt.toLocaleDateString(tag, { weekday: 'long' }),
          num: String(dt.getDate()),
          month: dt.toLocaleDateString(tag, { month: 'short' }),
          items: payload.filter((p) => p.date === iso),
        };
      })
    : [];
---
<div data-schedule-root={uid}>
  {layout === 'week' && (
    <div class="schedule-week">
      {payload.map((item) => (
        <button type="button" class="schedule-card" data-schedule-open={item.id} aria-haspopup="dialog">
          <div class="schedule-card__day">{item.dayName}</div>
          <div class="schedule-card__date">{item.dayNum}</div>
          <div class="schedule-card__time">{item.time}</div>
          <h3>{item.title}</h3>
          {item.oldStyleLabel && <div class="schedule-card__old">{dict.schedule.oldStyleLabel}: {item.oldStyleLabel}</div>}
        </button>
      ))}
    </div>
  )}

  {layout === 'calendar' && (
    <div class="wcal">
      {calendarDays.map((day) => (
        <div class:list={['wcal__day', day.isToday && 'is-today', day.items.length === 0 && 'is-empty']}>
          <div class="wcal__head">
            <span class="wcal__dow" title={day.dowLong}>{day.dow}</span>
            <span class="wcal__num">{day.num}</span>
            <span class="wcal__mon">{day.month}</span>
            {day.isToday && labels && <span class="wcal__today">{labels.today}</span>}
          </div>
          <div class="wcal__items">
            {day.items.map((item) => (
              <button type="button" class="wcal__item" data-schedule-open={item.id} aria-haspopup="dialog">
                <span class="wcal__time">{item.time}</span>
                <span class="wcal__title">{item.title}</span>
                {item.oldStyleLabel && <span class="wcal__old">{dict.schedule.oldStyleLabel}: {item.oldStyleLabel}</span>}
              </button>
            ))}
            {day.items.length === 0 && labels && <p class="wcal__empty">{labels.empty}</p>}
          </div>
        </div>
      ))}
    </div>
  )}

  {layout === 'list' && (
    <ul class="schedule-list schedule-list--rich">
      {payload.map((item) => (
        <li>
          <button type="button" class="schedule-item schedule-item--rich" data-schedule-open={item.id} aria-haspopup="dialog">
            <span class="date-tile" aria-hidden="true">
              <span class="date-tile__day">{item.dayNum}</span>
              <span class="date-tile__mon">{item.monthShort}</span>
            </span>
            <span class="schedule-item__body">
              <span class="schedule-item__meta">
                <span>{item.dateLabel}</span>
                <span>{item.time}</span>
                {item.oldStyleLabel && (
                  <span class="old-style">{dict.schedule.oldStyleLabel}: {item.oldStyleLabel}</span>
                )}
              </span>
              <span class="schedule-item__title">{item.title}</span>
              <span class="schedule-item__desc">{item.description}</span>
            </span>
            <span class="schedule-item__go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
          </button>
        </li>
      ))}
    </ul>
  )}

  {layout === 'compact' && (
    <ul class="sched-rows">
      {payload.map((item) => (
        <li>
          <button type="button" class="sched-row" data-schedule-open={item.id} aria-haspopup="dialog">
            <span class="sched-row__when">{weekly ? item.weekdayLong : item.shortDate}</span>
            <span class="sched-row__time">{item.time}</span>
            <span class="sched-row__title">{item.title}</span>
          </button>
        </li>
      ))}
    </ul>
  )}

  <div class="panel-backdrop" data-panel-backdrop hidden></div>
  <aside class="panel" data-schedule-panel role="dialog" aria-modal="true" aria-labelledby={`${uid}-title`} hidden>
    <div class="panel__header">
      <div>
        <p class="eyebrow" style="margin:0 0 0.35rem;">{dict.schedule.addToCalendar}</p>
        <h2 id={`${uid}-title`} data-panel-title style="margin:0;font-size:1.4rem;"></h2>
      </div>
      <button type="button" class="btn btn-secondary" data-panel-close>{dict.schedule.close}</button>
    </div>
    <div class="panel__body">
      <p data-panel-desc></p>
      <p><strong>{dict.schedule.date}:</strong> <span data-panel-date></span></p>
      <p data-panel-old-wrap hidden><strong>{dict.schedule.oldStyleLabel}:</strong> <span data-panel-old></span></p>
      <p><strong>{dict.schedule.time}:</strong> <span data-panel-time></span></p>
      <p><strong>{dict.schedule.location}:</strong> <span data-panel-location></span></p>
      <div class="panel__actions">
        <a class="btn btn-primary" data-panel-ics download="service.ics">{dict.schedule.downloadIcs}</a>
        <a class="btn btn-secondary" data-panel-google target="_blank" rel="noopener noreferrer">{dict.schedule.googleCal}</a>
        <a class="btn btn-secondary" data-panel-map target="_blank" rel="noopener noreferrer">{dict.schedule.directions}</a>
      </div>
    </div>
  </aside>
</div>

<script define:vars={{ payload, uid }}>
  const root = document.querySelector(`[data-schedule-root="${uid}"]`);
  if (root) {
    const byId = Object.fromEntries(payload.map((p) => [p.id, p]));
    const panel = root.querySelector('[data-schedule-panel]');
    const backdrop = root.querySelector('[data-panel-backdrop]');
    const title = root.querySelector('[data-panel-title]');
    const desc = root.querySelector('[data-panel-desc]');
    const date = root.querySelector('[data-panel-date]');
    const oldWrap = root.querySelector('[data-panel-old-wrap]');
    const old = root.querySelector('[data-panel-old]');
    const time = root.querySelector('[data-panel-time]');
    const location = root.querySelector('[data-panel-location]');
    const ics = root.querySelector('[data-panel-ics]');
    const google = root.querySelector('[data-panel-google]');
    const map = root.querySelector('[data-panel-map]');
    let opener = null;

    function openPanel(id, btn) {
      const item = byId[id];
      if (!item || !panel) return;
      opener = btn;
      title.textContent = item.title;
      desc.textContent = item.description;
      date.textContent = item.dateLabel;
      time.textContent = item.time;
      location.textContent = item.location;
      if (item.oldStyleLabel) {
        oldWrap.hidden = false;
        old.textContent = item.oldStyleLabel;
      } else {
        oldWrap.hidden = true;
      }
      const blob = new Blob([item.ics], { type: 'text/calendar;charset=utf-8' });
      ics.href = URL.createObjectURL(blob);
      ics.download = `${item.id}.ics`;
      google.href = item.google;
      map.href = item.map;
      panel.hidden = false;
      backdrop.hidden = false;
      requestAnimationFrame(() => {
        panel.classList.add('is-open');
        backdrop.classList.add('is-open');
      });
      panel.querySelector('[data-panel-close]')?.focus();
    }

    function closePanel() {
      if (!panel || panel.hidden) return;
      panel.classList.remove('is-open');
      backdrop?.classList.remove('is-open');
      setTimeout(() => {
        panel.hidden = true;
        if (backdrop) backdrop.hidden = true;
      }, 250);
      opener?.focus();
    }

    root.querySelectorAll('[data-schedule-open]').forEach((btn) => {
      btn.addEventListener('click', () => openPanel(btn.getAttribute('data-schedule-open'), btn));
    });
    root.querySelector('[data-panel-close]')?.addEventListener('click', closePanel);
    backdrop?.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel();
    });
  }
</script>
