---
import type { Locale } from '../config/site';
import { siteConfig } from '../config/site';
import type { ScheduleItem } from '../config/schedule';
import { nextDays } from '../config/schedule';
import { t } from '../i18n/ui';
import { displayDates, formatShortDate, buildIcs, googleCalendarUrl } from '../utils/dates';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  items: ScheduleItem[];
  layout?: 'tile' | 'cards' | 'list' | 'calendar' | 'compact';
  /** compact layout: label rows by weekday instead of date */
  weekly?: boolean;
  labels?: { today: string; empty: string };
  /** cards layout: label for services that are streamed */
  liveLabel?: string;
  narrow?: boolean;
}
const { locale, items, layout = 'list', weekly = false, labels, liveLabel, narrow = false } = Astro.props;
const dict = t(locale);
const parish = siteConfig.name[locale];
const tag = locale === 'ro' ? 'ro-RO' : 'en-GB';
const uid = `sch-${Math.random().toString(36).slice(2, 8)}`;

const toDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(y, m - 1, d, 12);
};

const cap = (s: string) => s.charAt(0).toLocaleUpperCase(tag) + s.slice(1);

const iconFor = (id: string) => {
  if (id.startsWith('liturgy')) return 'church';
  if (id.startsWith('vespers') || id.startsWith('matins')) return 'candle';
  if (id.startsWith('unction') || id.startsWith('paraklesis')) return 'hands';
  return 'music';
};

const payload = items.map((item) => {
  const dates = displayDates(item.date, locale);
  const dt = toDate(item.date);
  return {
    id: item.id,
    date: item.date,
    title: item.title[locale],
    description: item.description[locale],
    dateLabel: dates.primary,
    shortDate: formatShortDate(item.date, locale),
    dayNum: String(dt.getDate()),
    dayName: dt.toLocaleDateString(tag, { weekday: 'short' }),
    weekdayLong: cap(dt.toLocaleDateString(tag, { weekday: 'long' })),
    monthShort: dt.toLocaleDateString(tag, { month: 'short' }).replace('.', ''),
    oldStyleLabel: dates.secondary,
    start: item.startTime,
    time: `${item.startTime}-${item.endTime}`,
    location: item.location?.[locale] ?? parish,
    live: Boolean(item.live),
    icon: iconFor(item.id),
    ics: buildIcs(item, locale, parish),
    google: googleCalendarUrl(item, locale, parish),
    map: siteConfig.mapUrl,
  };
});

const clientPayload = payload.map(({ icon, live, start, ...rest }) => rest);

const today = nextDays(1)[0];
const calendarDays =
  layout === 'calendar'
    ? nextDays(7).map((iso) => {
        const dt = toDate(iso);
        return {
          iso,
          isToday: iso === today,
          dow: dt.toLocaleDateString(tag, { weekday: 'short' }),
          dowLong: dt.toLocaleDateString(tag, { weekday: 'long' }),
          num: String(dt.getDate()),
          month: dt.toLocaleDateString(tag, { month: 'short' }).replace('.', ''),
          items: payload.filter((p) => p.date === iso),
        };
      })
    : [];
---
<div data-schedule-root={uid}>
  {layout === 'tile' && (
    <ul class="next-list">
      {payload.map((item) => (
        <li>
          <button type="button" class="next-item" data-schedule-open={item.id} aria-haspopup="dialog">
            <span class="next-item__date" aria-hidden="true">
              <span class="next-item__day">{item.dayNum}</span>
              <span class="next-item__mon">{item.monthShort}</span>
            </span>
            <span class="next-item__text">
              <span class="next-item__title">{item.title}</span>
              <span class="next-item__when">
                {item.weekdayLong}, {item.time}
                {item.oldStyleLabel && <> · {dict.schedule.oldStyleLabel}: {item.oldStyleLabel}</>}
              </span>
            </span>
            <Icon name="arrow" size={18} />
          </button>
        </li>
      ))}
    </ul>
  )}

  {layout === 'cards' && (
    <ul class:list={['wcards', { 'wcards--narrow': narrow }]}>
      {payload.map((item) => (
        <li>
          <button type="button" class="wcard" data-schedule-open={item.id} aria-haspopup="dialog">
            <span class="wcard__icon"><Icon name={item.icon} size={26} /></span>
            <span class="wcard__day">{item.weekdayLong}</span>
            <span class="wcard__time">{item.start}</span>
            <span class="wcard__title">{item.title}</span>
            {item.live && liveLabel && <span class="wcard__note">{liveLabel}</span>}
          </button>
        </li>
      ))}
    </ul>
  )}

  {layout === 'calendar' && (
    <div class="wcal">
      {calendarDays.map((day) => (
        <div class:list={['wcal__day', day.isToday && 'is-today', day.items.length === 0 && 'is-empty']}>
          <div class="wcal__head">
            <span class="wcal__dow" title={day.dowLong}>{day.dow}</span>
            <span class="wcal__num">{day.num}</span>
            <span class="wcal__mon">{day.month}</span>
            {day.isToday && labels && <span class="wcal__today">{labels.today}</span>}
          </div>
          <ul class="wcal__items">
            {day.items.map((item) => (
              <li>
                <button type="button" class="wcal__item" data-schedule-open={item.id} aria-haspopup="dialog">
                  <span class="wcal__time">{item.time}</span>
                  <span class="wcal__title">{item.title}</span>
                  {item.oldStyleLabel && <span class="wcal__old">{dict.schedule.oldStyleLabel}: {item.oldStyleLabel}</span>}
                </button>
              </li>
            ))}
            {day.items.length === 0 && labels && <li class="wcal__empty">{labels.empty}</li>}
          </ul>
        </div>
      ))}
    </div>
  )}

  {layout === 'list' && (
    <ul class="schedule-list">
      {payload.map((item) => (
        <li>
          <button type="button" class="schedule-item" data-schedule-open={item.id} aria-haspopup="dialog">
            <span class="date-tile" aria-hidden="true">
              <span class="date-tile__day">{item.dayNum}</span>
              <span class="date-tile__mon">{item.monthShort}</span>
            </span>
            <span class="schedule-item__body">
              <span class="schedule-item__meta">
                <span>{item.dateLabel}</span>
                <span>{item.time}</span>
                {item.oldStyleLabel && <span class="old-style">{dict.schedule.oldStyleLabel}: {item.oldStyleLabel}</span>}
              </span>
              <span class="schedule-item__title">{item.title}</span>
              <span class="schedule-item__desc">{item.description}</span>
            </span>
            <span class="schedule-item__go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
          </button>
        </li>
      ))}
    </ul>
  )}

  {layout === 'compact' && (
    <ul class="sched-rows">
      {payload.map((item) => (
        <li>
          <button type="button" class="sched-row" data-schedule-open={item.id} aria-haspopup="dialog">
            <span class="sched-row__title">{item.title}</span>
            <span class="sched-row__when">{weekly ? item.weekdayLong : item.shortDate}</span>
            <span class="sched-row__time">{item.start}</span>
          </button>
        </li>
      ))}
    </ul>
  )}

  <div class="panel-backdrop" data-panel-backdrop hidden></div>
  <aside class="panel" data-schedule-panel data-panel-owner={uid} role="dialog" aria-modal="true" aria-labelledby={`${uid}-title`} hidden>
    <div class="panel__header">
      <div>
        <p class="eyebrow" style="margin:0 0 0.4rem">{dict.schedule.addToCalendar}</p>
        <h2 id={`${uid}-title`} data-panel-title></h2>
      </div>
      <button type="button" class="panel__close" data-panel-close aria-label={dict.schedule.close}>
        <Icon name="x" size={18} />
      </button>
    </div>
    <div class="panel__body">
      <p data-panel-desc></p>
      <dl class="panel__facts">
        <div><dt>{dict.schedule.date}</dt><dd data-panel-date></dd></div>
        <div data-panel-old-wrap hidden><dt>{dict.schedule.oldStyleLabel}</dt><dd data-panel-old></dd></div>
        <div><dt>{dict.schedule.time}</dt><dd data-panel-time></dd></div>
        <div><dt>{dict.schedule.location}</dt><dd data-panel-location></dd></div>
      </dl>
      <div class="panel__actions">
        <a class="btn btn-primary" data-panel-ics download="service.ics"><Icon name="calendar" size={18} />{dict.schedule.downloadIcs}</a>
        <a class="btn btn-secondary" data-panel-google target="_blank" rel="noopener noreferrer"><Icon name="external" size={18} />{dict.schedule.googleCal}</a>
        <a class="btn btn-secondary" data-panel-map target="_blank" rel="noopener noreferrer"><Icon name="pin" size={18} />{dict.schedule.directions}</a>
      </div>
    </div>
  </aside>
</div>

<script define:vars={{ payload: clientPayload, uid }}>
  const root = document.querySelector(`[data-schedule-root="${uid}"]`);
  if (root) {
    const byId = Object.fromEntries(payload.map((p) => [p.id, p]));
    const panel = root.querySelector('[data-schedule-panel]');
    const backdrop = root.querySelector('[data-panel-backdrop]');
    if (panel && backdrop) document.body.append(backdrop, panel);
    const q = (sel) => panel?.querySelector(sel);
    const title = q('[data-panel-title]');
    const desc = q('[data-panel-desc]');
    const date = q('[data-panel-date]');
    const oldWrap = q('[data-panel-old-wrap]');
    const old = q('[data-panel-old]');
    const time = q('[data-panel-time]');
    const location = q('[data-panel-location]');
    const ics = q('[data-panel-ics]');
    const google = q('[data-panel-google]');
    const map = q('[data-panel-map]');
    let opener = null;

    function openPanel(id, btn) {
      const item = byId[id];
      if (!item || !panel) return;
      opener = btn;
      title.textContent = item.title;
      desc.textContent = item.description;
      date.textContent = item.dateLabel;
      time.textContent = item.time;
      location.textContent = item.location;
      if (item.oldStyleLabel) {
        oldWrap.hidden = false;
        old.textContent = item.oldStyleLabel;
      } else {
        oldWrap.hidden = true;
      }
      const blob = new Blob([item.ics], { type: 'text/calendar;charset=utf-8' });
      ics.href = URL.createObjectURL(blob);
      ics.download = `${item.id}.ics`;
      google.href = item.google;
      map.href = item.map;
      panel.hidden = false;
      backdrop.hidden = false;
      requestAnimationFrame(() => {
        panel.classList.add('is-open');
        backdrop.classList.add('is-open');
      });
      q('[data-panel-close]')?.focus();
    }

    function closePanel() {
      if (!panel || panel.hidden) return;
      panel.classList.remove('is-open');
      backdrop?.classList.remove('is-open');
      setTimeout(() => {
        panel.hidden = true;
        if (backdrop) backdrop.hidden = true;
      }, 250);
      opener?.focus();
    }

    root.querySelectorAll('[data-schedule-open]').forEach((btn) => {
      btn.addEventListener('click', () => openPanel(btn.getAttribute('data-schedule-open'), btn));
    });
    q('[data-panel-close]')?.addEventListener('click', closePanel);
    backdrop?.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel();
    });
  }
</script>
