---
import Ornament from './Ornament.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'start' | 'center';
  light?: boolean;
  id?: string;
}
const { eyebrow, title, lede, align = 'start', light = false, id } = Astro.props;
---
<div class:list={['shead', align === 'center' && 'shead--center', light && 'shead--light']}>
  <div class="shead__row">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={id}>{title}</h2>
    </div>
    <slot name="aside" />
  </div>
  <Ornament align={align} light={light} />
  {lede && <p class="lede shead__lede">{lede}</p>}
</div>
