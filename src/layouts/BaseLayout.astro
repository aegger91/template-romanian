---
import type { Locale } from '../config/site';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  current?: string;
}
const { locale, title, description = '', current = 'home' } = Astro.props;
const dict = t(locale);
const fullTitle = `${title} · ${siteConfig.name[locale]}`;
const og = images.og.src;
---
<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || siteConfig.tagline[locale]} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description || siteConfig.tagline[locale]} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={locale === 'ro' ? 'ro_RO' : 'en_GB'} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=EB+Garamond:wght@500;600;700&family=Literata:opsz,wght@7..72,400;7..72,600;7..72,700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
          visibility: visible !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.a11y.skip}</a>
    <Header locale={locale} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = Array.from(document.querySelectorAll('.reveal'));

      function showAll() {
        nodes.forEach((el) => el.classList.add('is-visible'));
      }

      if (reduce || !('IntersectionObserver' in window)) {
        showAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        nodes.forEach((el) => io.observe(el));
        // Never leave content hidden if observer fails or items stay offscreen edge cases
        window.setTimeout(showAll, 2500);
      }

      // Safety if the inline head script did not run
      root.classList.remove('no-js');
      root.classList.add('js');
    </script>
  </body>
</html>
