---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import Icon from '../components/Icon.astro';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';

const locale = 'ro' as const;
const dict = t(locale);
const pg = p(locale);
const links = [
  { href: dict.paths.schedule, label: dict.nav.schedule, en: '/en/schedule/', enLabel: 'Services' },
  { href: dict.paths.parish, label: dict.nav.parish, en: '/en/parish/', enLabel: 'Our Parish' },
  { href: dict.paths.pomelnice, label: dict.nav.pomelnice, en: '/en/commemoration/', enLabel: 'Commemoration names' },
  { href: dict.paths.contact, label: dict.nav.contact, en: '/en/contact/', enLabel: 'Contact' },
];
---
<BaseLayout locale={locale} title={dict.notFound.title} current="home">
  <PageBanner
    image={{ src: images.pages.notFound.src, alt: images.pages.notFound.alt[locale] }}
    eyebrow={pg.notFound.eyebrow}
    title={dict.notFound.title}
    lede={dict.notFound.text}
    crumbs={[{ label: dict.nav.home, href: '/' }, { label: '404' }]}
    crumbLabel={pg.common.breadcrumb}
  >
    <p class="banner__lede" lang="en" style="margin-bottom:1.25rem">The page you requested does not exist.</p>
    <div class="btn-row" style="margin-top:0">
      <a class="btn btn-white" href="/">{dict.notFound.home}</a>
      <a class="btn btn-light" href="/en/" lang="en">Home (EN)</a>
    </div>
  </PageBanner>

  <section class="section">
    <div class="container">
      <Heading eyebrow="Useful pages" title={pg.notFound.links} />
      <div class="grid grid-4">
        {links.map((l) => (
          <div class="card quick-link">
            <a href={l.href}>{l.label} <Icon name="arrow" size={16} /></a>
            <p class="small" style="margin:0.4rem 0 0"><a class="text-link" href={l.en} lang="en" style="font-family:var(--font-body);font-size:0.85rem">{l.enLabel}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
