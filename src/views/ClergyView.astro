---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import Motif from '../components/Motif.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Portrait from '../components/Portrait.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const c = pg.clergy;
const [lead, ...team] = siteConfig.clergy;
const tel = (n: string) => `tel:${n.replace(/\D/g, '')}`;
---
<BaseLayout locale={locale} title={dict.nav.clergy} current="parish" description={c.lede}>
  <PageBanner
    image={{ src: images.pages.clergy.src, alt: images.pages.clergy.alt[locale] }}
    eyebrow={dict.nav.parish}
    title={dict.nav.clergy}
    lede={c.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.parish, href: dict.paths.parish }, { label: dict.nav.clergy }])}
    crumbLabel={pg.common.breadcrumb}
    position="center 30%"
  />

  <section class="section">
    <div class="container reveal">
      <div class="feature">
        <div class="feature__media">
          <Portrait name={lead.name} photo={lead.photo} label={pg.common.photo} tone={0} />
        </div>
        <div class="feature__body">
          <p class="eyebrow">{lead.role[locale]}</p>
          <h2>{lead.name}</h2>
          <Motif />
          <p class="lede">{lead.bio[locale]}</p>
          <ul class="info-list" style="margin-top:1.25rem">
            {'email' in lead && lead.email && (
              <li><Icon name="mail" size={18} /><span><span class="info-list__label">{dict.contact.email}</span><a class="info-list__value" href={`mailto:${lead.email}`}>{lead.email}</a></span></li>
            )}
            {'phone' in lead && lead.phone && (
              <li><Icon name="phone" size={18} /><span><span class="info-list__label">{dict.contact.phone}</span><a class="info-list__value" href={tel(lead.phone)}>{lead.phone}</a></span></li>
            )}
          </ul>
          <div class="btn-row">
            <a class="btn btn-primary" href={dict.paths.sacraments}>{c.featuredCta}</a>
            <a class="btn btn-secondary" href={dict.paths.contact}>{c.featuredSecondary}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={c.teamEyebrow} title={c.teamTitle} />
      <div class="grid grid-3">
        {team.map((person, i) => (
          <article class="person">
            <div class="person__media">
              <Portrait name={person.name} photo={person.photo} label={pg.common.photo} tone={i + 1} />
            </div>
            <div class="person__body">
              <p class="person__role">{person.role[locale]}</p>
              <h3 class="person__name">{person.name}</h3>
              <p class="person__bio">{person.bio[locale]}</p>
              {'email' in person && person.email && (
                <ul class="person__contact">
                  <li><Icon name="mail" size={16} /><a href={`mailto:${person.email}`}>{person.email}</a></li>
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="aside-panel dark-block">
        <Heading eyebrow={c.pastoralEyebrow} title={c.pastoralTitle} lede={c.pastoralText} light />
        <div class="grid grid-3">
          {c.pastoral.map((it) => (
            <div class="dark-card">
              <span class="icon-badge icon-badge--light"><Icon name={it.icon} size={20} /></span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>
          ))}
        </div>
        <div class="btn-row btn-row--center" style="margin-top:2rem">
          <a class="btn btn-white" href={`tel:${siteConfig.phone.replace(/\D/g, '')}`}><Icon name="phone" size={18} />{siteConfig.phone}</a>
          <a class="btn btn-light" href={`mailto:${siteConfig.email}`}><Icon name="mail" size={18} />{siteConfig.email}</a>
        </div>
      </div>
    </div>
  </section>

  <PhotoBand
    image={{ src: images.pages.sacraments.src, alt: images.pages.sacraments.alt[locale] }}
    eyebrow={c.ctaEyebrow}
    title={c.ctaTitle}
    text={c.ctaText}
    href={dict.paths.sacraments}
    label={c.ctaLabel}
  />
</BaseLayout>
