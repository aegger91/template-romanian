---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import Motif from '../components/Motif.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const c = pg.contact;
const addr = siteConfig.address;
const m = images.media;
const tel = `tel:${siteConfig.phone.replace(/\D/g, '')}`;
---
<BaseLayout locale={locale} title={dict.contact.title} current="contact" description={c.lede}>
  <PageBanner
    image={{ src: images.pages.contact.src, alt: images.pages.contact.alt[locale] }}
    eyebrow={dict.nav.contact}
    title={dict.contact.title}
    lede={c.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.contact }])}
    crumbLabel={pg.common.breadcrumb}
  />

  <section class="section section--tight">
    <div class="container reveal">
      <div class="grid grid-3">
        <div class="card">
          <span class="icon-badge"><Icon name="pin" size={20} /></span>
          <p class="info-list__label">{dict.contact.address}</p>
          <p class="info-list__value" style="margin:0.3rem 0 0">{addr.street}<br />{addr.postal} {addr.city}, {addr.country[locale]}</p>
        </div>
        <div class="card">
          <span class="icon-badge"><Icon name="phone" size={20} /></span>
          <p class="info-list__label">{dict.contact.phone}</p>
          <p class="info-list__value" style="margin:0.3rem 0 0"><a href={tel}>{siteConfig.phone}</a></p>
        </div>
        <div class="card">
          <span class="icon-badge"><Icon name="mail" size={20} /></span>
          <p class="info-list__label">{dict.contact.email}</p>
          <p class="info-list__value" style="margin:0.3rem 0 0"><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container split split--form reveal">
      <div class="card form-card">
        <p class="eyebrow">{c.infoEyebrow}</p>
        <h2 class="form-card__title">{dict.contact.formTitle}</h2>
        <Motif />
        <p class="form-intro">{c.infoText}</p>
        <ContactForm locale={locale} />
      </div>
      <div class="stack">
        <div class="map-card">
          <div class="map-card__body">
            <span class="map-card__pin"><Icon name="pin" size={22} /></span>
            <p class="map-card__addr">{addr.street}, {addr.city}</p>
            <div class="btn-row btn-row--center" style="margin-top:0.25rem">
              <a class="btn btn-primary btn-sm" href={siteConfig.maps.google} target="_blank" rel="noopener noreferrer">{c.openGoogle}</a>
              <a class="btn btn-secondary btn-sm" href={siteConfig.maps.apple} target="_blank" rel="noopener noreferrer">{c.openApple}</a>
              <a class="btn btn-secondary btn-sm" href={siteConfig.maps.osm} target="_blank" rel="noopener noreferrer">{c.openOsm}</a>
            </div>
            <p class="map-card__note">{c.mapNote}</p>
          </div>
        </div>
        <div class="card">
          <h3 class="card__title" style="font-size:1.25rem">{c.hoursTitle}</h3>
          <dl class="hours">
            {c.hours.map((h) => (
              <div><dt>{h.label}</dt><dd>{h.value}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={c.directionsEyebrow} title={c.directionsTitle} />
      <div class="grid grid-3">
        {c.directions.map((it) => (
          <div class="card" style="background:var(--cream)">
            <span class="icon-badge"><Icon name={it.icon} size={20} /></span>
            <h3 class="card__title" style="font-size:1.2rem">{it.title}</h3>
            <p class="card__text">{it.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split reveal">
      <div>
        <p class="eyebrow">{c.hoursEyebrow}</p>
        <h2>{dict.parish.visitingTitle}</h2>
        <Motif />
        <p class="lede">{dict.parish.visitingText}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={dict.paths.schedule}>{dict.schedule.title}</a>
          <a class="btn btn-secondary" href={dict.paths.parish}>{dict.nav.parish}</a>
        </div>
      </div>
      <figure class="figure figure--wide">
        <img src={m.dragomirna.src} alt={m.dragomirna.alt[locale]} width={m.dragomirna.w} height={m.dragomirna.h} loading="lazy" />
        <figcaption>{c.visitCaption}</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>
