---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import Motif from '../components/Motif.astro';
import AmountForm from '../components/AmountForm.astro';
import OrthodoxCross from '../components/OrthodoxCross.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const d = pg.donate;
const m = images.media;
const showProgress = siteConfig.features.donationProgress && siteConfig.features.donationAutoCount;
const iban = d.ways[0].lines[1].split(': ')[1];
---
<BaseLayout locale={locale} title={dict.donate.title} current="donate" description={d.lede}>
  <PageBanner
    image={{ src: images.pages.donate.src, alt: images.pages.donate.alt[locale] }}
    eyebrow={dict.nav.donate}
    title={dict.donate.title}
    lede={d.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.donate }])}
    crumbLabel={pg.common.breadcrumb}
  />

  <section class="section section--tight">
    <div class="container split split--form reveal">
      <div class="card form-card" id="donate-form">
        <p class="eyebrow">{d.formEyebrow}</p>
        <h2 class="form-card__title">{d.formTitle}</h2>
        <Motif />
        <p class="form-intro">{dict.donate.intro}</p>
        <AmountForm locale={locale} kind="donate" />
      </div>
      <div class="stack stack--sticky">
        <aside class="aside-panel">
          <p class="eyebrow">{d.asideEyebrow}</p>
          <h2>{d.asideTitle}</h2>
          <ul class="aside-list">
            {d.asideItems.map((it) => (
              <li><Icon name={it.icon} size={20} />{it.text}</li>
            ))}
          </ul>
          <p class="aside-quote">{d.thanksText}</p>
        </aside>
        <figure class="figure figure--wide">
          <img src={m.frescoHumor.src} alt={m.frescoHumor.alt[locale]} width={m.frescoHumor.w} height={m.frescoHumor.h} loading="lazy" />
          <figcaption>{m.frescoHumor.alt[locale]}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={d.waysEyebrow} title={d.waysTitle} />
      <div class="grid grid-3">
        {d.ways.map((w, i) => (
          <article class="card">
            <span class="icon-badge"><Icon name={w.icon} size={20} /></span>
            <h3 class="card__title">{w.title}</h3>
            <ul class="plain-lines">
              {w.lines.map((line) => <li>{line}</li>)}
            </ul>
            {i === 0 && (
              <button type="button" class="btn btn-secondary btn-sm js-only" data-copy={iban} data-copied={d.copied}>
                <Icon name="copy" size={16} /><span data-copy-label>{d.copy}</span>
              </button>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="feature">
        <div class="feature__media">
          <img src={m.frescoSucevita.src} alt={m.frescoSucevita.alt[locale]} width={m.frescoSucevita.w} height={m.frescoSucevita.h} loading="lazy" />
        </div>
        <div class="feature__body">
          <p class="eyebrow">{d.projectEyebrow}</p>
          <h2>{d.projectTitle}</h2>
          <Motif />
          <p class="lede">{d.projectText}</p>
          {showProgress && (
            <div>
              <p class="eyebrow">{dict.donate.progressLabel}</p>
              <div class="progress" aria-hidden="true"><span style="width:42%"></span></div>
            </div>
          )}
          <div class="btn-row">
            <a class="btn btn-accent" href="#donate-form">{d.projectCta}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--deep">
    <div class="container quote reveal">
      <OrthodoxCross size={30} class="quote__cross" />
      <h2>{d.thanksTitle}</h2>
      <Motif center />
      <p class="lede" style="margin-inline:auto">{d.thanksText}</p>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || '');
        if (label) label.textContent = btn.dataset.copied || '';
      } catch {
        /* clipboard unavailable */
      }
    });
  });
</script>
