---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SubNav from '../components/SubNav.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { images } from '../config/images';
import { featuredIcons } from '../config/gallery';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { parishTabs, crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const g = pg.gallery;
---
<BaseLayout locale={locale} title={dict.nav.gallery} current="parish" description={g.lede}>
  <PageHero
    image={{ src: images.pages.gallery.src, alt: images.pages.gallery.alt[locale] }}
    eyebrow={dict.nav.parish}
    title={dict.nav.gallery}
    lede={g.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.parish, href: dict.paths.parish }, { label: dict.nav.gallery }])}
    crumbLabel={pg.common.breadcrumb}
  />
  <SubNav items={parishTabs(locale, 'gallery')} label={pg.common.sectionNav} />

  <section class="reveal section section--dark section--ornate">
    <div class="container">
      <SectionHead eyebrow={g.iconsEyebrow} title={g.iconsTitle} lede={g.iconsLede} align="center" light />
      <div class="icon-row-framed" role="list">
        {featuredIcons.map((icon) => (
          <figure class="icon-frame icon-frame--small" role="listitem">
            <img src={icon.src} alt={icon.alt[locale]} width="900" height="1200" loading="lazy" />
            <figcaption>{icon.alt[locale]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="reveal section">
    <div class="container">
      <SectionHead eyebrow={g.gridEyebrow} title={g.gridTitle} />
      <GalleryGrid locale={locale} />
    </div>
  </section>

  <CtaBand
    image={{ src: images.pages.contact.src, alt: images.pages.contact.alt[locale] }}
    eyebrow={g.ctaEyebrow}
    title={g.ctaTitle}
    text={g.ctaText}
    href={dict.paths.contact}
    label={g.ctaLabel}
  />
</BaseLayout>
