---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import PhotoBand from '../components/PhotoBand.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { images } from '../config/images';
import { featuredIcons } from '../config/gallery';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const g = pg.gallery;
---
<BaseLayout locale={locale} title={dict.nav.gallery} current="parish" description={g.lede}>
  <PageBanner
    image={{ src: images.pages.gallery.src, alt: images.pages.gallery.alt[locale] }}
    eyebrow={dict.nav.parish}
    title={dict.nav.gallery}
    lede={g.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.parish, href: dict.paths.parish }, { label: dict.nav.gallery }])}
    crumbLabel={pg.common.breadcrumb}
  />

  <section class="section">
    <div class="container reveal">
      <Heading eyebrow={g.iconsEyebrow} title={g.iconsTitle} lede={g.iconsLede} />
      <div class="icon-row">
        {featuredIcons.map((icon) => (
          <figure class="icon-fig">
            <img src={icon.src} alt={icon.alt[locale]} width="900" height="1200" loading="lazy" />
            <figcaption>{icon.alt[locale]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={g.gridEyebrow} title={g.gridTitle} />
      <GalleryGrid locale={locale} />
    </div>
  </section>

  <PhotoBand
    image={{ src: images.pages.contact.src, alt: images.pages.contact.alt[locale] }}
    eyebrow={g.ctaEyebrow}
    title={g.ctaTitle}
    text={g.ctaText}
    href={dict.paths.contact}
    label={g.ctaLabel}
  />
</BaseLayout>
