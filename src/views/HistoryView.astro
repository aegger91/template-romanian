---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import Motif from '../components/Motif.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Icon from '../components/Icon.astro';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const h = pg.history;
const m = images.media;
const milestoneImages: Record<string, { src: string; alt: string; w: number; h: number }> = {
  wooden: { src: m.botiza.src, alt: m.botiza.alt[locale], w: m.botiza.w, h: m.botiza.h },
  church: { src: m.dragomirna.src, alt: m.dragomirna.alt[locale], w: m.dragomirna.w, h: m.dragomirna.h },
  fresco: { src: m.frescoMoldovita.src, alt: m.frescoMoldovita.alt[locale], w: m.frescoMoldovita.w, h: m.frescoMoldovita.h },
};
const strip = [m.frescoSucevita, m.voronet, m.frescoHumor, m.iconostasis];
---
<BaseLayout locale={locale} title={dict.nav.history} current="parish" description={h.lede}>
  <PageBanner
    image={{ src: images.pages.history.src, alt: images.pages.history.alt[locale] }}
    eyebrow={dict.nav.parish}
    title={dict.nav.history}
    lede={h.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.parish, href: dict.paths.parish }, { label: dict.nav.history }])}
    crumbLabel={pg.common.breadcrumb}
  />

  <section class="section">
    <div class="container reveal" style="max-width:46rem">
      <Heading eyebrow={h.introEyebrow} title={h.introTitle} lede={h.introText} />
    </div>
    <div class="container reveal">
      <ol class="timeline">
        {h.milestones.map((ms) => {
          const pic = 'image' in ms ? milestoneImages[ms.image as string] : undefined;
          return (
            <li class="timeline__item">
              <p class="timeline__year">{ms.year}</p>
              <div class="timeline__body">
                <h3>{ms.title}</h3>
                <p>{ms.text}</p>
                {pic && <img src={pic.src} alt={pic.alt} width={pic.w} height={pic.h} loading="lazy" />}
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <div class="inscription" style="background:var(--cream)">
        <p class="eyebrow">{h.inscriptionEyebrow}</p>
        <h2>{h.inscriptionTitle}</h2>
        <Motif center />
        <blockquote>{h.inscriptionText}</blockquote>
        <p class="small muted" style="margin:0">{h.inscriptionNote}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <Heading eyebrow={h.foundersEyebrow} title={h.foundersTitle} />
      <ol class="step-cards">
        {h.founders.map((f) => (
          <li class="card">
            <h3 class="card__title">{f.title}</h3>
            <p class="card__text">{f.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={h.galleryEyebrow} title={h.galleryTitle} />
      <div class="grid grid-4">
        {strip.map((it) => (
          <figure class="figure figure--wide">
            <img src={it.src} alt={it.alt[locale]} width={it.w} height={it.h} loading="lazy" />
            <figcaption>{it.alt[locale]}</figcaption>
          </figure>
        ))}
      </div>
      <p class="section-foot"><a class="link-arrow" href={dict.paths.gallery}>{dict.nav.gallery} <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <PhotoBand
    image={{ src: images.pages.gallery.src, alt: images.pages.gallery.alt[locale] }}
    eyebrow={h.ctaEyebrow}
    title={h.ctaTitle}
    text={h.ctaText}
    href={dict.paths.gallery}
    label={h.ctaLabel}
  />
</BaseLayout>
