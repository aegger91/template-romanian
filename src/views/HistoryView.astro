---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SubNav from '../components/SubNav.astro';
import SectionHead from '../components/SectionHead.astro';
import Ornament from '../components/Ornament.astro';
import CtaBand from '../components/CtaBand.astro';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { parishTabs, crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const h = pg.history;
const m = images.media;
const milestoneImages: Record<string, { src: string; alt: string; w: number; h: number }> = {
  wooden: { src: m.botiza.src, alt: m.botiza.alt[locale], w: 900, h: 1200 },
  church: { src: m.dragomirna.src, alt: m.dragomirna.alt[locale], w: 1200, h: 900 },
  fresco: { src: m.frescoMoldovita.src, alt: m.frescoMoldovita.alt[locale], w: 1200, h: 900 },
};
const strip = [m.frescoSucevita, m.voronet, m.frescoHumor, m.iconostasis];
---
<BaseLayout locale={locale} title={dict.nav.history} current="parish" description={h.lede}>
  <PageHero
    image={{ src: images.pages.history.src, alt: images.pages.history.alt[locale] }}
    eyebrow={dict.nav.parish}
    title={dict.nav.history}
    lede={h.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.parish, href: dict.paths.parish }, { label: dict.nav.history }])}
    crumbLabel={pg.common.breadcrumb}
  />
  <SubNav items={parishTabs(locale, 'history')} label={pg.common.sectionNav} />

  <section class="reveal section">
    <div class="container split split--intro">
      <div class="year-mark" aria-hidden="true">
        <span class="year-mark__num">1936</span>
        <span class="year-mark__rule"></span>
        <span class="year-mark__num year-mark__num--small">{new Date().getFullYear()}</span>
      </div>
      <div>
        <SectionHead eyebrow={h.introEyebrow} title={h.introTitle} />
        <p class="lede">{h.introText}</p>
      </div>
    </div>
  </section>

  <section class="reveal section section--band">
    <div class="container">
      <SectionHead eyebrow={h.timelineEyebrow} title={h.timelineTitle} align="center" />
      <ol class="timeline">
        {h.milestones.map((ms, i) => {
          const pic = 'image' in ms ? milestoneImages[ms.image as string] : undefined;
          return (
            <li class:list={['timeline__item', i % 2 === 1 && 'timeline__item--alt']}>
              <span class="timeline__dot" aria-hidden="true">
                <img src="/icons/cross-trefoil.svg" alt="" width="14" height="14" />
              </span>
              <article class="timeline__card">
                <p class="timeline__year">{ms.year}</p>
                <h3>{ms.title}</h3>
                <p class="timeline__text">{ms.text}</p>
                {pic && (
                  <div class="timeline__media">
                    <img src={pic.src} alt={pic.alt} width={pic.w} height={pic.h} loading="lazy" />
                  </div>
                )}
              </article>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="reveal section">
    <div class="container">
      <div class="inscription">
        <p class="eyebrow">{h.inscriptionEyebrow}</p>
        <h2>{h.inscriptionTitle}</h2>
        <Ornament align="center" />
        <blockquote class="inscription__text">{h.inscriptionText}</blockquote>
        <p class="inscription__note">{h.inscriptionNote}</p>
      </div>
    </div>
  </section>

  <section class="reveal section section--band">
    <div class="container">
      <SectionHead eyebrow={h.foundersEyebrow} title={h.foundersTitle} />
      <div class="card-grid">
        {h.founders.map((f, i) => (
          <article class="card card--gold feature-card card--lift">
            <span class="feature-card__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reveal section">
    <div class="container">
      <SectionHead eyebrow={h.galleryEyebrow} title={h.galleryTitle}>
        <a slot="aside" class="section-link" href={dict.paths.gallery}>{dict.nav.gallery} →</a>
      </SectionHead>
      <div class="gallery-strip" role="list">
        {strip.map((it) => (
          <figure role="listitem">
            <img src={it.src} alt={it.alt[locale]} width={it.w} height={it.h} loading="lazy" />
            <figcaption>{it.alt[locale]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    image={{ src: images.pages.gallery.src, alt: images.pages.gallery.alt[locale] }}
    eyebrow={h.ctaEyebrow}
    title={h.ctaTitle}
    text={h.ctaText}
    href={dict.paths.gallery}
    label={h.ctaLabel}
  />
</BaseLayout>
