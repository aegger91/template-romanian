---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import ScheduleList from '../components/ScheduleList.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { thisWeekServices, previousWeekdayDate } from '../config/schedule';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { formatShortDate } from '../utils/dates';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const l = pg.livestream;
const m = images.media;
const archiveImages: Record<string, string> = {
  iconostasis: m.iconostasis.src,
  interior: m.frescoSucevita.src,
  fresco: m.frescoVoronet.src,
};
const archiveDates = [previousWeekdayDate(0), previousWeekdayDate(6), previousWeekdayDate(3)];
---
<BaseLayout locale={locale} title={dict.livestream.title} current="livestream" description={l.lede}>
  <PageBanner
    image={{ src: images.pages.livestream.src, alt: images.pages.livestream.alt[locale] }}
    eyebrow={dict.nav.livestream}
    title={dict.livestream.title}
    lede={l.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.livestream }])}
    crumbLabel={pg.common.breadcrumb}
  />

  <section class="section section--tight">
    <div class="container stream reveal">
      <div>
        <div class="player">
          <img src={images.livestream.src} alt={images.livestream.alt[locale]} width="1280" height="1067" />
          <div class="player__overlay">
            <span class="status-pill"><span class="status-pill__dot" aria-hidden="true"></span>{l.status}</span>
            <p class="player__title">{l.playerTitle}</p>
            <p class="player__text">{l.playerText}</p>
            <a class="btn btn-white" href={siteConfig.livestreamUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="external" size={17} />{dict.livestream.openExternal}
            </a>
          </div>
        </div>
        <p class="form-note" style="margin-top:0.85rem">{dict.livestream.offline}</p>
      </div>
      <aside class="card">
        <h3 class="card__title" style="font-size:1.25rem;display:flex;align-items:center;gap:0.6rem"><Icon name="live" size={20} />{l.upcomingTitle}</h3>
        <ScheduleList locale={locale} items={thisWeekServices} layout="compact" />
        <a class="link-arrow" style="margin-top:1rem" href={dict.paths.schedule}>{dict.schedule.title} <Icon name="arrow" size={16} /></a>
      </aside>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={l.whereEyebrow} title={l.whereTitle} />
      <div class="grid grid-3">
        {l.platforms.map((pl) => (
          <article class="card">
            <span class="icon-badge"><Icon name={pl.icon} size={20} /></span>
            <h3 class="card__title">{pl.title}</h3>
            <p class="card__text">{pl.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <Heading eyebrow={l.archiveEyebrow} title={l.archiveTitle} />
      <div class="grid grid-3">
        {l.archive.map((rec, i) => (
          <a class="pcard video-card" href={siteConfig.livestreamUrl} target="_blank" rel="noopener noreferrer">
            <div class="pcard__media">
              <img src={archiveImages[rec.image]} alt="" width="1200" height="900" loading="lazy" />
              <span class="video-card__play" aria-hidden="true"><Icon name="play" size={28} /></span>
              <span class="video-card__duration">{rec.duration}</span>
            </div>
            <div class="pcard__body">
              <div class="meta-row"><time datetime={archiveDates[i]}>{formatShortDate(archiveDates[i], locale)}</time></div>
              <h3 class="card__title">{rec.title}</h3>
              <span class="link-arrow">{l.watch} <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <PhotoBand
    image={{ src: images.pages.pomelnice.src, alt: images.pages.pomelnice.alt[locale] }}
    eyebrow={l.ctaEyebrow}
    title={l.ctaTitle}
    text={l.ctaText}
    href={dict.paths.pomelnice}
    label={l.ctaLabel}
  />
</BaseLayout>
