---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SubNav from '../components/SubNav.astro';
import SectionHead from '../components/SectionHead.astro';
import ScheduleList from '../components/ScheduleList.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { thisWeekServices, previousWeekdayDate } from '../config/schedule';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { formatShortDate } from '../utils/dates';
import { serviceTabs, crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const l = pg.livestream;
const m = images.media;
const archiveImages: Record<string, string> = {
  iconostasis: m.iconostasis.src,
  interior: m.frescoSucevita.src,
  fresco: m.frescoVoronet.src,
};
const archiveDates = [previousWeekdayDate(0), previousWeekdayDate(6), previousWeekdayDate(3)];
---
<BaseLayout locale={locale} title={dict.livestream.title} current="livestream" description={l.lede}>
  <PageHero
    image={{ src: images.pages.livestream.src, alt: images.pages.livestream.alt[locale] }}
    eyebrow={dict.nav.livestream}
    title={dict.livestream.title}
    lede={l.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.livestream }])}
    crumbLabel={pg.common.breadcrumb}
  />
  <SubNav items={serviceTabs(locale, 'livestream')} label={pg.common.sectionNav} />

  <section class="reveal section">
    <div class="container stream-layout">
      <div class="stream-player">
        <div class="livestream-frame livestream-frame--gilded">
          <img src={images.livestream.src} alt={images.livestream.alt[locale]} width="1280" height="1067" />
          <div class="stream-player__overlay">
            <span class="status-pill"><span class="status-pill__dot" aria-hidden="true"></span>{l.status}</span>
            <span class="stream-player__icon" aria-hidden="true"><Icon name="play" size={34} /></span>
            <p class="stream-player__title">{l.playerTitle}</p>
            <p class="stream-player__text">{l.playerText}</p>
            <a class="btn btn-gold" href={siteConfig.livestreamUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="external" size={17} />{dict.livestream.openExternal}
            </a>
          </div>
        </div>
        <p class="form-note" style="margin-top:0.85rem;">{dict.livestream.offline}</p>
      </div>
      <aside class="card card--gold aside-card stream-upcoming">
        <h3 class="aside-card__title"><Icon name="live" size={20} />{l.upcomingTitle}</h3>
        <ScheduleList locale={locale} items={thisWeekServices} layout="compact" />
        <a class="section-link" style="display:inline-block;margin-top:1rem;" href={dict.paths.schedule}>{dict.schedule.title} →</a>
      </aside>
    </div>
  </section>

  <section class="reveal section section--band">
    <div class="container">
      <SectionHead eyebrow={l.whereEyebrow} title={l.whereTitle} />
      <div class="card-grid">
        {l.platforms.map((pl) => (
          <article class="card card--gold feature-card card--lift">
            <span class="feature-card__icon"><Icon name={pl.icon} size={26} /></span>
            <h3>{pl.title}</h3>
            <p>{pl.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reveal section">
    <div class="container">
      <SectionHead eyebrow={l.archiveEyebrow} title={l.archiveTitle} />
      <div class="card-grid">
        {l.archive.map((rec, i) => (
          <a class="story-card story-card--video card--lift" href={siteConfig.livestreamUrl} target="_blank" rel="noopener noreferrer">
            <span class="story-card__media">
              <img src={archiveImages[rec.image]} alt="" width="1200" height="900" loading="lazy" />
              <span class="story-card__play" aria-hidden="true"><Icon name="play" size={28} /></span>
              <span class="story-card__duration">{rec.duration}</span>
            </span>
            <span class="story-card__body">
              <time class="story-card__when" datetime={archiveDates[i]}>{formatShortDate(archiveDates[i], locale)}</time>
              <span class="story-card__title">{rec.title}</span>
              <span class="photo-card__more">{l.watch} <Icon name="arrow" size={16} /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    image={{ src: images.pages.pomelnice.src, alt: images.pages.pomelnice.alt[locale] }}
    eyebrow={l.ctaEyebrow}
    title={l.ctaTitle}
    text={l.ctaText}
    href={dict.paths.pomelnice}
    label={l.ctaLabel}
  />
</BaseLayout>
