---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ScheduleList from '../components/ScheduleList.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Ornament from '../components/Ornament.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { upcomingEvents, newsItems } from '../config/schedule';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { formatShortDate } from '../utils/dates';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const n = pg.news;
const [featured, ...rest] = newsItems;
const calendarLabel = siteConfig.calendarStyle === 'old' ? dict.schedule.calendarOld : dict.schedule.calendarNew;
---
<BaseLayout locale={locale} title={dict.news.title} current="news" description={n.lede}>
  <PageHero
    image={{ src: images.pages.news.src, alt: images.pages.news.alt[locale] }}
    eyebrow={dict.nav.news}
    title={dict.news.title}
    lede={n.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.news }])}
    crumbLabel={pg.common.breadcrumb}
  />

  <section class="reveal section">
    <div class="container">
      <article class="feature-story">
        <div class="feature-story__media">
          <img src={featured.image} alt="" width="1200" height="900" loading="lazy" />
        </div>
        <div class="feature-story__body">
          <p class="feature-story__meta">
            <span class="tag tag--gold">{n.featuredEyebrow}</span>
            <span class="tag">{featured.category[locale]}</span>
            <time datetime={featured.date}>{formatShortDate(featured.date, locale)}</time>
          </p>
          <h2>{featured.title[locale]}</h2>
          <Ornament />
          <p class="lede">{featured.summary[locale]}</p>
          {featured.body && <p>{featured.body[locale]}</p>}
        </div>
      </article>
    </div>
  </section>

  <section class="reveal section section--band">
    <div class="container">
      <SectionHead eyebrow={n.latestEyebrow} title={n.latestTitle} />
      <div class="card-grid">
        {rest.map((item) => (
          <article class="story-card card--lift">
            <div class="story-card__media">
              <img src={item.image} alt="" width="1200" height="900" loading="lazy" />
              <time class="story-card__date" datetime={item.date}>{formatShortDate(item.date, locale)}</time>
            </div>
            <div class="story-card__body">
              <span class="tag">{item.category[locale]}</span>
              <h3>{item.title[locale]}</h3>
              <p>{item.summary[locale]}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reveal section">
    <div class="container split split--aside">
      <div>
        <SectionHead eyebrow={n.eventsEyebrow} title={n.eventsTitle}>
          <span slot="aside" class="calendar-badge">{calendarLabel}</span>
        </SectionHead>
        <ScheduleList locale={locale} items={upcomingEvents} layout="list" />
      </div>
      <aside class="aside-stack">
        <div class="notice-board">
          <h3 class="aside-card__title"><Icon name="pin2" size={20} />{n.noticesTitle}</h3>
          <ul>
            {n.notices.map((note) => <li>{note}</li>)}
          </ul>
        </div>
        <a class="mini-card" href={dict.paths.livestream}>
          <span class="mini-card__media"><img src={images.media.iconostasis.src} alt="" width="1200" height="900" loading="lazy" /></span>
          <span class="mini-card__body">
            <span class="mini-card__title"><span class="live-dot" aria-hidden="true"></span>{dict.nav.livestream}</span>
            <span class="mini-card__text">{pg.schedule.liveText}</span>
            <span class="photo-card__more">{pg.schedule.liveCta} <Icon name="arrow" size={16} /></span>
          </span>
        </a>
      </aside>
    </div>
  </section>

  <section class="reveal section section--dark section--ornate">
    <div class="container newsletter-band">
      <div>
        <p class="eyebrow">{n.newsletterEyebrow}</p>
        <h2>{n.newsletterTitle}</h2>
        <Ornament light />
        <p class="lede lede--light" style="margin-bottom:0;">{n.newsletterText}</p>
      </div>
      <NewsletterForm locale={locale} />
    </div>
  </section>
</BaseLayout>
