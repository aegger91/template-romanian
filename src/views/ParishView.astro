---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import Motif from '../components/Motif.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { nextFeast } from '../config/schedule';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { displayDates } from '../utils/dates';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const c = pg.parish;
const m = images.media;
const feast = displayDates(nextFeast.date, locale);
const explore = [
  { href: dict.paths.history, title: dict.nav.history, text: c.cards.history, image: m.frescoVoronet },
  { href: dict.paths.clergy, title: dict.nav.clergy, text: c.cards.clergy, image: m.stelea },
  { href: dict.paths.gallery, title: dict.nav.gallery, text: c.cards.gallery, image: m.frescoMoldovita },
  { href: dict.paths.sacraments, title: dict.nav.sacraments, text: c.cards.sacraments, image: m.iconostasis },
];
---
<BaseLayout locale={locale} title={dict.parish.title} current="parish" description={c.lede}>
  <PageBanner
    image={{ src: images.pages.parish.src, alt: images.pages.parish.alt[locale] }}
    eyebrow={siteConfig.tagline[locale]}
    title={dict.parish.title}
    lede={c.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.parish }])}
    crumbLabel={pg.common.breadcrumb}
  />

  {siteConfig.features.aboutBlock && (
    <section class="section">
      <div class="container split reveal">
        <div>
          <p class="eyebrow">{c.welcomeEyebrow}</p>
          <h2>{c.welcomeTitle}</h2>
          <Motif />
          <p class="lede">{c.welcomeText}</p>
          <dl class="stats">
            {c.facts.map((f) => (
              <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
            ))}
          </dl>
          <div class="btn-row">
            <a class="btn btn-primary" href={dict.paths.schedule}>{dict.nav.schedule}</a>
            <a class="btn btn-secondary" href={dict.paths.contact}>{dict.nav.contact}</a>
          </div>
        </div>
        <figure class="figure figure--wide">
          <img src={m.humor.src} alt={m.humor.alt[locale]} width={m.humor.w} height={m.humor.h} loading="lazy" />
          <figcaption>{m.humor.alt[locale]}</figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={c.exploreEyebrow} title={c.exploreTitle} lede={c.exploreLede} />
      <div class="grid grid-4">
        {explore.map((card) => (
          <a class="pcard" href={card.href}>
            <div class="pcard__media">
              <img src={card.image.src} alt="" width={card.image.w} height={card.image.h} loading="lazy" />
            </div>
            <div class="pcard__body">
              <h3 class="card__title">{card.title}</h3>
              <p class="card__text">{card.text}</p>
              <span class="link-arrow">{pg.common.learnMore} <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="feature">
        <div class="feature__media feature__media--icon">
          <img src={m.iconNicholas.src} alt={m.iconNicholas.alt[locale]} width={m.iconNicholas.w} height={m.iconNicholas.h} loading="lazy" />
        </div>
        <div class="feature__body">
          <p class="eyebrow">{c.patronEyebrow}</p>
          <h2>{c.patronTitle}</h2>
          <Motif />
          <p class="lede">{c.patronText}</p>
          <div class="date-line">
            <span>{dict.home.nextFeast}</span>
            <strong>{feast.primary}</strong>
            <span>{nextFeast.startTime}-{nextFeast.endTime} · {nextFeast.description[locale]}</span>
            {feast.secondary && <span class="old-style">{dict.schedule.oldStyleLabel}: {feast.secondary}</span>}
          </div>
          <div class="btn-row">
            <a class="btn btn-primary" href={dict.paths.schedule}>{c.patronCta}</a>
          </div>
          <p class="small muted" style="margin:1.25rem 0 0">{c.patronIconCaption}</p>
        </div>
      </div>
    </div>
  </section>

  {siteConfig.features.visitingBlock && (
    <section class="section section--paper">
      <div class="container reveal">
        <Heading eyebrow={c.visitEyebrow} title={c.visitTitle} lede={c.visitText} />
        <div class="grid grid-4">
          {c.visitItems.map((it) => (
            <div class="card">
              <span class="icon-badge"><Icon name={it.icon} size={20} /></span>
              <h3 class="card__title" style="font-size:1.2rem">{it.title}</h3>
              <p class="card__text">{it.text}</p>
            </div>
          ))}
        </div>
        <p class="section-foot"><a class="link-arrow" href={dict.paths.contact}>{dict.contact.title} <Icon name="arrow" size={16} /></a></p>
      </div>
    </section>
  )}

  <PhotoBand
    image={{ src: images.pages.schedule.src, alt: images.pages.schedule.alt[locale] }}
    eyebrow={c.ctaEyebrow}
    title={c.ctaTitle}
    text={c.ctaText}
    href={dict.paths.schedule}
    label={c.ctaLabel}
    secondary={{ href: dict.paths.livestream, label: dict.nav.livestream }}
  />
</BaseLayout>
