---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import Motif from '../components/Motif.astro';
import AmountForm from '../components/AmountForm.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Icon from '../components/Icon.astro';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const c = pg.pomelnice;
const m = images.media;
---
<BaseLayout locale={locale} title={dict.pomelnice.title} current="pomelnice" description={c.lede}>
  <PageBanner
    image={{ src: images.pages.pomelnice.src, alt: images.pages.pomelnice.alt[locale] }}
    eyebrow={dict.nav.schedule}
    title={dict.pomelnice.title}
    lede={c.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.schedule, href: dict.paths.schedule }, { label: dict.nav.pomelnice }])}
    crumbLabel={pg.common.breadcrumb}
  />

  <section class="section section--tight">
    <div class="container split split--form reveal">
      <div class="card form-card">
        <p class="eyebrow">{c.formEyebrow}</p>
        <h2 class="form-card__title">{c.formTitle}</h2>
        <Motif />
        <p class="form-intro">{dict.pomelnice.intro}</p>
        <AmountForm locale={locale} kind="pomelnice" />
      </div>
      <div class="stack stack--sticky">
        <aside class="aside-panel">
          <p class="eyebrow">{c.readTitle}</p>
          <dl class="aside-rows">
            {c.readItems.map((item) => (
              <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
            ))}
          </dl>
          <div class="aside-panel__inner">
            <h3 style="font-size:1.2rem;display:flex;align-items:center;gap:0.55rem"><Icon name="candle" size={18} />{c.asideTitle}</h3>
            <p style="margin:0 0 0.5rem">{c.asideText}</p>
            <p style="margin:0;color:#fff;display:flex;align-items:center;gap:0.5rem"><Icon name="clock" size={16} />{c.asideHours}</p>
          </div>
          <div class="btn-row">
            <a class="btn btn-light btn-sm" href={dict.paths.schedule}>{dict.nav.schedule} <Icon name="arrow" size={15} /></a>
          </div>
        </aside>
        <figure class="figure figure--wide">
          <img src={m.candleBoxes.src} alt={m.candleBoxes.alt[locale]} width={m.candleBoxes.w} height={m.candleBoxes.h} loading="lazy" />
          <figcaption>{c.asideCaption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={c.stepsEyebrow} title={c.stepsTitle} />
      <ol class="step-cards">
        {c.steps.map((step) => (
          <li class="card" style="background:var(--cream)">
            <h3 class="card__title">{step.title}</h3>
            <p class="card__text">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <PhotoBand
    image={{ src: images.pages.livestream.src, alt: images.pages.livestream.alt[locale] }}
    eyebrow={c.ctaEyebrow}
    title={c.ctaTitle}
    text={c.ctaText}
    href={dict.paths.livestream}
    label={c.ctaLabel}
  />
</BaseLayout>
