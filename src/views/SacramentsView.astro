---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import Motif from '../components/Motif.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Pictogram from '../components/Pictogram.astro';
import RequestForm from '../components/RequestForm.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const s = pg.sacraments;
const hours = pg.contact.hours[0];
---
<BaseLayout locale={locale} title={dict.nav.sacraments} current="schedule" description={s.lede}>
  <PageBanner
    image={{ src: images.pages.sacraments.src, alt: images.pages.sacraments.alt[locale] }}
    eyebrow={dict.nav.schedule}
    title={dict.nav.sacraments}
    lede={s.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.schedule, href: dict.paths.schedule }, { label: dict.nav.sacraments }])}
    crumbLabel={pg.common.breadcrumb}
  />

  <section class="section">
    <div class="container reveal">
      <Heading eyebrow={s.introEyebrow} title={s.introTitle} lede={s.introText} />
      <div class="grid grid-4">
        {s.items.map((it) => {
          const href = 'href' in it ? dict.paths.pomelnice : '#cerere';
          return (
            <article class="card rite" id={it.id}>
              <span class="rite__picto"><Pictogram name={it.icon} size={52} /></span>
              <h3 class="card__title">{it.title}</h3>
              <p class="rite__tags">
                {it.tags.map((tag, i) => <span class:list={['tag', i === 0 && 'tag--gold']}>{tag}</span>)}
              </p>
              <p class="card__text">{it.text}</p>
              <div class="card__foot">
                <a class="link-arrow" href={href} data-request-pick={'href' in it ? undefined : it.id}>
                  {'href' in it ? dict.pomelnice.submit : pg.common.request}
                  <Icon name="arrow" size={16} />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--paper" id="cerere">
    <div class="container split split--form reveal">
      <div class="card form-card" style="background:var(--cream)">
        <p class="eyebrow">{s.formEyebrow}</p>
        <h2 class="form-card__title">{s.formTitle}</h2>
        <Motif />
        <p class="form-intro">{s.formText}</p>
        <RequestForm locale={locale} />
      </div>
      <aside class="aside-panel">
        <p class="eyebrow">{s.introEyebrow}</p>
        <h2>{s.officeTitle}</h2>
        <ol class="steps steps--light">
          {s.steps.map((step) => <li>{step}</li>)}
        </ol>
        <ul class="aside-list">
          <li><Icon name="clock" size={18} /><span>{hours.value}</span></li>
          <li><Icon name="phone" size={18} /><a href={`tel:${siteConfig.phone.replace(/\D/g, '')}`}>{siteConfig.phone}</a></li>
          <li><Icon name="mail" size={18} /><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
        </ul>
      </aside>
    </div>
  </section>

  <PhotoBand
    image={{ src: images.pages.pomelnice.src, alt: images.pages.pomelnice.alt[locale] }}
    eyebrow={s.ctaEyebrow}
    title={s.ctaTitle}
    text={s.ctaText}
    href={dict.paths.pomelnice}
    label={s.ctaLabel}
  />
</BaseLayout>
