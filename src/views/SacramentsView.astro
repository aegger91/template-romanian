---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SubNav from '../components/SubNav.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Pictogram from '../components/Pictogram.astro';
import RequestForm from '../components/RequestForm.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { serviceTabs, crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const s = pg.sacraments;
const hours = pg.contact.hours[0];
---
<BaseLayout locale={locale} title={dict.nav.sacraments} current="schedule" description={s.lede}>
  <PageHero
    image={{ src: images.pages.sacraments.src, alt: images.pages.sacraments.alt[locale] }}
    eyebrow={dict.nav.schedule}
    title={dict.nav.sacraments}
    lede={s.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.schedule, href: dict.paths.schedule }, { label: dict.nav.sacraments }])}
    crumbLabel={pg.common.breadcrumb}
  />
  <SubNav items={serviceTabs(locale, 'sacraments')} label={pg.common.sectionNav} />

  <section class="reveal section">
    <div class="container">
      <SectionHead eyebrow={s.introEyebrow} title={s.introTitle} lede={s.introText} align="center" />
      <div class="rite-grid">
        {s.items.map((it) => {
          const href = 'href' in it ? dict.paths.pomelnice : '#cerere';
          return (
            <article class="rite-card" id={it.id}>
              <div class="rite-card__arch" aria-hidden="true">
                <Pictogram name={it.icon} size={76} />
              </div>
              <div class="rite-card__body">
                <h3>{it.title}</h3>
                <p class="rite-card__tags">
                  {it.tags.map((tag, i) => (
                    <span class:list={['tag', i === 0 && 'tag--gold']}>
                      {i === 1 && <Icon name="clock" size={13} />}
                      {tag}
                    </span>
                  ))}
                </p>
                <p class="rite-card__text">{it.text}</p>
                <a class="btn btn-accent btn-sm" href={href} data-request-pick={'href' in it ? undefined : it.id}>
                  {'href' in it ? dict.pomelnice.submit : pg.common.request}
                  <Icon name="arrow" size={15} />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="reveal section section--band" id="cerere">
    <div class="container split split--form">
      <div>
        <SectionHead eyebrow={s.formEyebrow} title={s.formTitle} />
        <p class="lede">{s.formText}</p>
        <ol class="steps">
          {s.steps.map((step, i) => (
            <li class="steps__item">
              <span class="steps__num">{i + 1}</span>
              <span class="steps__text">{step}</span>
            </li>
          ))}
        </ol>
        <div class="card office-card">
          <h3 class="aside-card__title"><Icon name="home" size={20} />{s.officeTitle}</h3>
          <ul class="contact-lines">
            <li><Icon name="clock" size={18} /><span>{hours.value}</span></li>
            <li><Icon name="phone" size={18} /><a href={`tel:${siteConfig.phone.replace(/\D/g, '')}`}>{siteConfig.phone}</a></li>
            <li><Icon name="mail" size={18} /><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="card card--gold form-card">
        <RequestForm locale={locale} />
      </div>
    </div>
  </section>

  <CtaBand
    image={{ src: images.pages.pomelnice.src, alt: images.pages.pomelnice.alt[locale] }}
    eyebrow={s.ctaEyebrow}
    title={s.ctaTitle}
    text={s.ctaText}
    href={dict.paths.pomelnice}
    label={s.ctaLabel}
  />
</BaseLayout>
