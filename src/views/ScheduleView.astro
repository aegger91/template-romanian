---
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Heading from '../components/Heading.astro';
import ScheduleList from '../components/ScheduleList.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Pictogram from '../components/Pictogram.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { thisWeekServices, weeklyServices, upcomingEvents } from '../config/schedule';
import { t } from '../i18n/ui';
import { p } from '../i18n/pages';
import { crumbs } from './nav';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const pg = p(locale);
const s = pg.schedule;
const calendarLabel = siteConfig.calendarStyle === 'old' ? dict.schedule.calendarOld : dict.schedule.calendarNew;
const teaser = pg.sacraments.items.slice(0, 4);
const m = images.media;
---
<BaseLayout locale={locale} title={dict.schedule.title} current="schedule" description={s.lede}>
  <PageBanner
    image={{ src: images.pages.schedule.src, alt: images.pages.schedule.alt[locale] }}
    eyebrow={dict.nav.schedule}
    title={dict.schedule.title}
    lede={s.lede}
    crumbs={crumbs(locale, [{ label: dict.nav.schedule }])}
    crumbLabel={pg.common.breadcrumb}
  >
    <span class="calendar-badge calendar-badge--light">{calendarLabel}</span>
  </PageBanner>

  <section class="section">
    <div class="container reveal">
      <Heading eyebrow={pg.home.weeklyEyebrow} title={pg.home.weeklyTitle} lede={s.weeklyNote} />
      <ScheduleList locale={locale} items={thisWeekServices} layout="cards" liveLabel={pg.home.live} narrow />
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={s.weekEyebrow} title={s.weekTitle} lede={s.weekHint}>
        <span class="calendar-badge">{calendarLabel}</span>
      </Heading>
      <ScheduleList locale={locale} items={weeklyServices} layout="calendar" labels={{ today: s.today, empty: s.noServices }} />
    </div>
  </section>

  <section class="section">
    <div class="container split split--form reveal">
      <div>
        <Heading eyebrow={s.eventsEyebrow} title={s.eventsTitle} align="left" />
        <ScheduleList locale={locale} items={upcomingEvents} layout="list" />
      </div>
      <div class="stack stack--sticky">
        <div class="card">
          <h3 class="card__title" style="font-size:1.25rem">{s.weeklyTitle}</h3>
          <ScheduleList locale={locale} items={weeklyServices} layout="compact" weekly />
        </div>
        <a class="pcard" href={dict.paths.livestream}>
          <div class="pcard__media" style="aspect-ratio:16/7">
            <img src={m.stelea.src} alt="" width={m.stelea.w} height={m.stelea.h} loading="lazy" style="object-position:center 30%" />
          </div>
          <div class="pcard__body">
            <h3 class="card__title" style="font-size:1.25rem"><span class="live-dot" aria-hidden="true" style="margin-right:0.5rem;vertical-align:3px"></span>{s.liveTitle}</h3>
            <p class="card__text">{s.liveText}</p>
            <span class="link-arrow">{s.liveCta} <Icon name="arrow" size={16} /></span>
          </div>
        </a>
        <a class="pcard" href={dict.paths.pomelnice}>
          <div class="pcard__media" style="aspect-ratio:16/7">
            <img src={m.candles.src} alt="" width={m.candles.w} height={m.candles.h} loading="lazy" />
          </div>
          <div class="pcard__body">
            <h3 class="card__title" style="font-size:1.25rem">{s.namesTitle}</h3>
            <p class="card__text">{s.namesText}</p>
            <span class="link-arrow">{s.namesCta} <Icon name="arrow" size={16} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container reveal">
      <Heading eyebrow={s.sacramentsEyebrow} title={s.sacramentsTitle} lede={s.sacramentsText} />
      <div class="grid grid-4">
        {teaser.map((it) => (
          <a class="card card--link card--flex" href={`${dict.paths.sacraments}#${it.id}`}>
            <span class="rite__picto"><Pictogram name={it.icon} size={48} /></span>
            <h3 class="card__title">{it.title}</h3>
            <p class="card__text">{it.text}</p>
            <span class="card__foot link-arrow">{pg.common.learnMore} <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
      <p class="section-foot"><a class="btn btn-primary" href={dict.paths.sacraments}>{s.sacramentsCta}</a></p>
    </div>
  </section>

  <PhotoBand
    image={{ src: images.pages.livestream.src, alt: images.pages.livestream.alt[locale] }}
    eyebrow={s.ctaEyebrow}
    title={s.ctaTitle}
    text={s.ctaText}
    href={dict.paths.livestream}
    label={s.ctaLabel}
  />
</BaseLayout>
